<Window x:Class="Olden_Era___Template_Editor.OrientationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Ed.016}" Height="600" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1A2B" UseLayoutRounding="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8A857"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBox">
            <Setter Property="Background" Value="#0E1117"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderBrush" Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0E1117"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderBrush" Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7EBF3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="Background" Value="#141925"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="BorderBrush" Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Notice -->
                <Border Background="#1A2A3A" BorderBrush="#C8A857" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                    <TextBlock Foreground="#D0D0D0" FontSize="11" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Примечание:"/>
                        <Run Text="Параметры сериализуются в .rmg.json только после нажатия кнопки «Применить». Изменения вступают в силу немедленно после применения."/>
                    </TextBlock>
                </Border>

                <!-- ═══ ORIENTATION ═══ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Ориентация (orientation)"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Mode"/>
                <ComboBox x:Name="CmbMode" Style="{StaticResource FieldCombo}" SelectedIndex="1">
                    <ComboBoxItem Content="MinimalBoundingSquare"/>
                    <ComboBoxItem Content="BoundingCircle"/>
                    <ComboBoxItem Content="(не задано)"/>
                </ComboBox>

                <TextBlock Style="{StaticResource FieldLabel}" Text="ZeroAngleZone"/>
                <ComboBox x:Name="CmbZeroAngleZone" Style="{StaticResource FieldCombo}"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="BaseAngleMin"/>
                <TextBox x:Name="TxtBaseAngleMin" Style="{StaticResource FieldValue}" Text="45"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="BaseAngleMax"/>
                <TextBox x:Name="TxtBaseAngleMax" Style="{StaticResource FieldValue}" Text="45"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="RandomAngleAmplitude"/>
                <TextBox x:Name="TxtRandomAngleAmplitude" Style="{StaticResource FieldValue}" Text="360"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="RandomAngleStep"/>
                <TextBox x:Name="TxtRandomAngleStep" Style="{StaticResource FieldValue}" Text="90"/>

                <!-- ═══ BORDER ═══ -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Граница (border)"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="CornerRadius"/>
                <TextBox x:Name="TxtCornerRadius" Style="{StaticResource FieldValue}" Text="0.0"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="ObstaclesWidth"/>
                <TextBox x:Name="TxtObstaclesWidth" Style="{StaticResource FieldValue}" Text="3"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="ObstaclesNoise — Amplitude"/>
                <TextBox x:Name="TxtObstaclesNoiseAmp" Style="{StaticResource FieldValue}" Text="1"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="ObstaclesNoise — Frequency"/>
                <TextBox x:Name="TxtObstaclesNoiseFreq" Style="{StaticResource FieldValue}" Text="12"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="WaterWidth"/>
                <TextBox x:Name="TxtWaterWidth" Style="{StaticResource FieldValue}" Text="0"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="WaterNoise — Amplitude"/>
                <TextBox x:Name="TxtWaterNoiseAmp" Style="{StaticResource FieldValue}" Text="1"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="WaterNoise — Frequency"/>
                <TextBox x:Name="TxtWaterNoiseFreq" Style="{StaticResource FieldValue}" Text="12"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="WaterType (всегда 'water grass')"/>
                <TextBox x:Name="TxtWaterType" Style="{StaticResource ReadOnlyField}" Text="water grass"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="1" Background="#2A2540" Padding="10,8" CornerRadius="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnApply" Content="Применить" Width="110" Height="32"
                        Style="{StaticResource GenerateButton}"
                        Margin="0,0,8,0" Click="BtnApply_Click"/>
                <Button x:Name="BtnClearBorder" Content="Убрать border" Width="110" Height="32"
                        Margin="0,0,8,0" Click="BtnClearBorder_Click"
                        Background="#3A1A1A" Foreground="#E7EBF3"
                        BorderThickness="1" BorderBrush="#5A2A2A"
                        Cursor="Hand"/>
                <Button x:Name="BtnCancel" Content="Отмена" Width="90" Height="32"
                        Click="BtnCancel_Click"
                        Background="#2A2A3C" Foreground="#D0D0D0"
                        BorderThickness="1" BorderBrush="#3A3A4C"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
