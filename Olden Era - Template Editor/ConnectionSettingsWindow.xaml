<Window x:Class="Olden_Era___Template_Editor.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.CS.Title}" Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1A2B" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8A857"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="#302B45"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4A4570"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#302B45"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4A4570"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabelRead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="ReadValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S.CS.Settings}" Foreground="#C8A857"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource S.CS.Name}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource FieldInput}"/>

                <TextBlock Text="{DynamicResource S.CS.FromZone}" Style="{StaticResource FieldLabelRead}"/>
                <TextBlock x:Name="TxtFrom" Style="{StaticResource ReadValue}"/>

                <TextBlock Text="{DynamicResource S.CS.ToZone}" Style="{StaticResource FieldLabelRead}"/>
                <TextBlock x:Name="TxtTo" Style="{StaticResource ReadValue}"/>

                <TextBlock Text="{DynamicResource S.CS.Type}" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbType" Style="{StaticResource FieldCombo}" IsEditable="False"/>

                <TextBlock Text="{DynamicResource S.CS.GuardValue}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtGuardValue" Style="{StaticResource FieldInput}"/>

                <CheckBox x:Name="ChkRoad" Content="{DynamicResource S.CS.Road}" Margin="0,12,0,0"
                          Foreground="#D0D0D0" FontSize="12"/>

                <CheckBox x:Name="ChkGuardEscape" Content="{DynamicResource S.CS.GuardEscape}" Margin="0,8,0,0"
                          Foreground="#D0D0D0" FontSize="12"/>

                <TextBlock Text="{DynamicResource S.CS.GuardWeekly}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtGuardWeeklyInc" Style="{StaticResource FieldInput}"/>

                <TextBlock Text="{DynamicResource S.CS.GatePlacement}" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbGatePlacement" Style="{StaticResource FieldCombo}" IsEditable="True"/>

                <TextBlock Text="{DynamicResource S.CS.GuardRandom}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtGuardRandomization" Style="{StaticResource FieldInput}"/>

                <!-- Gate placement args (multi-select, visible only for NearZone) -->
                <StackPanel x:Name="GatePlacementArgsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="{DynamicResource S.CS.GateZones}" Style="{StaticResource FieldLabel}"/>
                    <ListBox x:Name="LstGatePlacementArgs" Background="#302B45" Foreground="#D0D0D0"
                             BorderThickness="1" BorderBrush="#4A4570" Padding="4"
                             FontSize="13" MinHeight="80" SelectionMode="Multiple"/>
                </StackPanel>

                <!-- Advanced section (guardZone + guardMatchGroup) -->
                <Expander Header="{DynamicResource S.EC.Advanced}" IsExpanded="False"
                          Margin="0,12,0,0" Foreground="#C8A857" FontSize="13">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource S.EC.GuardZone}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbGuardZone" Style="{StaticResource FieldCombo}" IsEditable="True"/>
                        <TextBlock Text="{DynamicResource S.CS.GuardMatchGroup}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtGuardMatchGroup" Style="{StaticResource FieldInput}"/>
                        <CheckBox x:Name="ChkSimTurnSquad" Content="{DynamicResource S.CS.SimTurnSquad}" Margin="0,8,0,0"
                                  Foreground="#D0D0D0" FontSize="12"/>
                        <TextBlock Text="{DynamicResource S.EC.AdvancedNote}"
                                   Foreground="#888" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>

                <StackPanel x:Name="PortalRulesPanel" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#2A2540" Padding="0,12" CornerRadius="6" Margin="0,8,0,0">
            <DockPanel>
                <Button x:Name="BtnSave" Content="{DynamicResource S.CS.Save}" DockPanel.Dock="Right"
                        Background="#6A5ACD" Foreground="White" BorderThickness="0"
                        Padding="20,8" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel" Content="{DynamicResource S.CS.Cancel}" DockPanel.Dock="Right"
                        Background="#4A4570" Foreground="#D0D0D0" BorderThickness="0"
                        Padding="16,8" FontSize="12" Margin="0,0,8,0"
                        Cursor="Hand" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
