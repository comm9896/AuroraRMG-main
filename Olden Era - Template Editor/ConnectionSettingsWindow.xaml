<Window x:Class="Olden_Era___Template_Editor.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор настроек связи" Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1A2B" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8A857"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="#302B45"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4A4570"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#302B45"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4A4570"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabelRead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="ReadValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки связи" Foreground="#C8A857"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Имя связи" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource FieldInput}"/>

                <TextBlock Text="Откуда (зона)" Style="{StaticResource FieldLabelRead}"/>
                <TextBlock x:Name="TxtFrom" Style="{StaticResource ReadValue}"/>

                <TextBlock Text="Куда (зона)" Style="{StaticResource FieldLabelRead}"/>
                <TextBlock x:Name="TxtTo" Style="{StaticResource ReadValue}"/>

                <TextBlock Text="Тип связи" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbType" Style="{StaticResource FieldCombo}" IsEditable="False"/>

                <TextBlock Text="Значение стражи" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtGuardValue" Style="{StaticResource FieldInput}"/>

                <CheckBox x:Name="ChkRoad" Content="Дорога (Road)" Margin="0,12,0,0"
                          Foreground="#D0D0D0" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#2A2540" Padding="0,12" CornerRadius="6" Margin="0,8,0,0">
            <DockPanel>
                <Button x:Name="BtnSave" Content="Сохранить" DockPanel.Dock="Right"
                        Background="#6A5ACD" Foreground="White" BorderThickness="0"
                        Padding="20,8" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel" Content="Отмена" DockPanel.Dock="Right"
                        Background="#4A4570" Foreground="#D0D0D0" BorderThickness="0"
                        Padding="16,8" FontSize="12" Margin="0,0,8,0"
                        Cursor="Hand" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
