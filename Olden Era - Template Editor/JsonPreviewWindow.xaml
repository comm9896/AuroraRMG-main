<Window x:Class="Olden_Era___Template_Editor.JsonPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Ed.JP.Title}" Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#1E1A2B" UseLayoutRounding="True"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2A2540" Padding="12,8">
            <DockPanel>
                <TextBlock Text="{DynamicResource S.Ed.JP.Title}" Foreground="#C8A857" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="OK" VerticalAlignment="Center" FontSize="11" Foreground="#6A6" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <TextBox x:Name="JsonBox" Grid.Row="1"
                 FontFamily="Consolas" FontSize="12"
                 Background="#12101E" Foreground="#D0D0D0"
                 BorderBrush="#2A2540" BorderThickness="0"
                 Padding="12"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 LostFocus="JsonBox_LostFocus"
                 TextChanged="JsonBox_TextChanged"/>

        <Border Grid.Row="2" Background="#2A2540" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="HintText" Text="{DynamicResource S.Ed.JP.Hint}"
                           VerticalAlignment="Center" FontSize="11" Foreground="#666"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnApply" Content="{DynamicResource S.Ed.JP.Apply}"
                            Background="#4A7040" Foreground="#D0D0D0" BorderThickness="0"
                            Padding="16,6" FontSize="12" Cursor="Hand"
                            Margin="0,0,8,0" IsEnabled="False" Click="BtnApply_Click"/>
                    <Button x:Name="BtnReset" Content="{DynamicResource S.Ed.JP.Reset}"
                            Background="#4A4570" Foreground="#D0D0D0" BorderThickness="0"
                            Padding="16,6" FontSize="12" Cursor="Hand"
                            Margin="0,0,8,0" Click="BtnReset_Click"/>
                    <Button x:Name="BtnClose" Content="{DynamicResource S.Ed.JP.Close}"
                            Background="#4A4570" Foreground="#D0D0D0" BorderThickness="0"
                            Padding="16,6" FontSize="12" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
