<Window x:Class="Olden_Era___Template_Editor.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.HK.Title}" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" Background="#1E1A2B"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource S.HK.Title}"
                   Foreground="#C8A857" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="Двойной клик по полю → нажмите клавишу. Сохраняется в settings.json."
                   Foreground="#666" FontSize="10" Margin="0,22,0,8"/>

        <Border Grid.Row="1" Background="#12101E" BorderBrush="#2A2540"
                BorderThickness="1" CornerRadius="4" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HotkeyList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#CCC"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#2A2540" BorderBrush="#3A3560"
                                        BorderThickness="1" CornerRadius="3" Padding="6,3"
                                        Cursor="Hand" MouseLeftButtonDown="HotkeyField_Click">
                                    <TextBlock x:Name="TxtKey" Text="{Binding Key}" Foreground="#CCC"
                                               FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" Content="✕" Background="Transparent"
                                        Foreground="#888" BorderThickness="0" Padding="4,0"
                                        FontSize="11" Cursor="Hand" Click="ClearHotkey_Click"
                                        Tag="{Binding Action}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource S.HK.ResetAll}" Background="#4A4570" Foreground="#D0D0D0"
                    BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand"
                    Margin="0,0,8,0" Click="BtnReset_Click"/>
            <Button Content="OK" Background="#4A7040" Foreground="#D0D0D0"
                    BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
