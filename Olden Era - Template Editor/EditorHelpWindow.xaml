<Window x:Class="Olden_Era___Template_Editor.EditorHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Визуальный редактор зон — справка" Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#1E1A2B" UseLayoutRounding="True"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <TextBlock Foreground="#D0D0D0" FontSize="12" LineHeight="20" TextWrapping="Wrap">
                <Run FontWeight="Bold" FontSize="16" Foreground="#C8A857" Text="Визуальный редактор зон"/>
                <LineBreak/>
                <Run Text="Графовый редактор шаблонов RMG для Heroes of Might and Magic: Olden Era."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Холст и навигация"/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Перетаскивание зон:"/> <Run Text="зоны можно перетаскивать мышью для наглядной компоновки. Позиции зон сохраняются только в окне редактора (в .rmg.json не записываются — генератор располагает зоны автоматически)."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Масштабирование:"/> <Run Text="колёсико мыши, кнопки +/−, сброс масштаба (100 %)."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Перекомпоновка:"/> <Run Text="кнопка «Relayout» пересчитывает позиции зон по алгоритму."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Привязка к сетке:"/> <Run Text="включает выравнивание зон по сетке при перетаскивании."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Работа с зонами и связями"/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Добавление зоны:"/> <Run Text="кнопка «Добавить зону» — новая зона появляется в центре холста со случайным именем."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Связывание зон:"/> <Run Text="нажмите «Режим связей», затем выберите две зоны последовательно. Между ними создаётся связь типа Default."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Удаление:"/> <Run Text="выберите зону или связь и нажмите «Удалить», либо клавишу Delete."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Копировать / Вставить зону:"/> <Run Text="копирует зону со всеми настройками (кроме связей). Работает в пределах сессии."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Менеджер связей:"/> <Run Text="отдельное окно для массового редактирования всех связей между зонами."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Валидация:"/> <Run Text="проверяет граф зон на ошибки: зоны без имени, дубликаты имён, ссылки на несуществующие зоны, самопетли, изолированные зоны."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Экспорт PNG:"/> <Run Text="сохраняет изображение графа зон в PNG."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Загрузка / Сохранение:"/> <Run Text="открывает и сохраняет .rmg.json файлы. При сохранении проводится повторная валидация."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Предпросмотр JSON:"/> <Run Text="показывает текущий шаблон в виде JSON в отдельном окне с возможностью редактирования."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Макет и границы:"/> <Run Text="отдельное окно для настройки orientation (mode, углы) и border (радиус, ширина препятствий, вода)."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Инспектор — вкладка «Основные» (TabMain)"/>
                <LineBreak/>
                <Run Text="Отображается при выборе зоны или связи. Основные параметры объекта."/>
                <LineBreak/>
                <Run Text="• Для зоны:"/> <Run Text="имя, относительный размер, раскладка (layout), модификатор дипломатии, множитель охраны."/>
                <LineBreak/>
                <Run Text="• Для связи:"/> <Run Text="имя связи, тип (Direct/Default/Portal/Proximity/GladiatorArena), сила охраны, флаг дороги (Road)."/>
                <LineBreak/>
                <Run Text="• Главный объект (MO):"/> <Run Text="тип (Placement), владелец (Owner), фракция, шанс/сила охраны, флаг убрать охрану при владении, условие победы (удержание города), здание, аргументы размещения."/>
                <LineBreak/>
                <Run Text="• Дополнительные MO:"/> <Run Text="для зон с Placement=Connection можно добавлять несколько главных объектов. Каждый имеет свой тип, владельца, PlacementArgs."/>
                <LineBreak/>
                <Run Text="• Дороги (Roads):"/> <Run Text="для зон с MO типа Connection настраиваются дороги: тип дороги, начальная и конечная точка (MainObject/Connection/Zone), мин./макс. расстояние."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Инспектор — вкладка «Охрана» (TabGuard)"/>
                <LineBreak/>
                <Run Text="Настройки охраны зоны и её объектов."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Порог охраны (GuardianCutoff):"/> <Run Text="максимальная сила охраны для случайных объектов в зоне."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Рандомизация охраны (GuardRandomizer):"/> <Run Text="разброс силы охраны."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Еженедельный прирост охраны (WeeklyGrowth):"/> <Run Text="насколько увеличивается охрана каждую неделю."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Распределение реакции охраны (GuardReactionDistribution):"/> <Run Text="как охрана распределяется по области."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Настройки дыр в столкновениях (EncounterHoles):"/> <Run Text="шанс пустых клеток у точек интереса и двойных пустых клеток."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Guard escape, Simultaneous turn squad, Gate placement:"/> <Run Text="дополнительные параметры поведения охраны."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Инспектор — вкладка «Пулы» (TabPools)"/>
                <LineBreak/>
                <Run Text="Управление пулами контента зоны."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Гарантированный пул (GuardedPool):"/> <Run Text="объекты, которые гарантированно появляются под охраной."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Негарантированный пул (UnguardedPool):"/> <Run Text="объекты без гарантии появления."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Пул ресурсов (ResourcesPool):"/> <Run Text="объекты ресурсов в зоне."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Обязательный контент (MandatoryContent):"/> <Run Text="объекты, которые обязаны появиться."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Лимиты количества контента (ContentCountLimits):"/> <Run Text="ограничения на количество контента каждого типа."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Ценность (Value) / на область (PerArea):"/> <Run Text="для guarded, unguarded и resources отдельно."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Кнопки действий:"/> <Run Text="«Добавить объекты контента» — выбор из пулов; для каждого объекта — количество, под охраной или у главного объекта, мин./макс. расстояние до дороги."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Инспектор — вкладка «Наполнение» (TabContent)"/>
                <LineBreak/>
                <Run Text="Детальная настройка типов контента, появляющихся в зоне."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Список объектов контента:"/> <Run Text="отображает все добавленные объекты с их параметрами."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Для каждого объекта:"/> <Run Text="имя, количество, флаг охраны, привязка к главному объекту, мин./макс. расстояние до дороги."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Удаление объекта:"/> <Run Text="кнопка «Удалить» напротив каждого объекта."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Инспектор — вкладка «Биом» (TabBiome)"/>
                <LineBreak/>
                <Run Text="Настройка биома зоны и контента."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Биом зоны (ZoneBiome):"/> <Run Text="основной биом для всей зоны."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Биом контента (ContentBiome):"/> <Run Text="биом для объектов контента в зоне."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Инспектор — вкладка «Объекты» (TabObjects)"/>
                <LineBreak/>
                <Run Text="Управление дополнительными настройками объектов зоны."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Список дополнительных объектов зоны:"/> <Run Text="объекты, добавленные через пулы контента."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Параметры каждого объекта:"/> <Run Text="тип, количество, охрана, позиция относительно главного объекта."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Возможность быстрого удаления:"/> <Run Text="кнопка «Удалить» для каждого объекта."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Управление пулами контента (глобально)"/>
                <LineBreak/>
                <Run Text="Кнопка «📋 Просмотр содержимого пулов» на вкладке «Пулы» открывает ContentPoolViewerWindow — окно для просмотра, поиска и отладки всех доступных пулов контента. Кнопка «➕ Создать новый пул» открывает ContentPoolCreatorWindow для создания собственных пулов."/>
                <LineBreak/><LineBreak/>

                <Run FontWeight="SemiBold" Foreground="#C8A857" Text="Цветовая легенда"/>
                <LineBreak/>
                <Run Text="Цвета зон соответствуют их типу раскладки (layout): зелёный — player_spawn, синий — Hub, голубой — ai_spawn, коричневый — sides, серый — treasure, золотой — center/supertreasure, фиолетовый — back и т.д."/>
                <LineBreak/>
                <Run Text="Толщина рамки зоны отражает количество связей: чем больше связей, тем толще рамка."/>
                <LineBreak/>
                <Run Text="Тип линии связи: сплошная жёлтая — Direct, серая — Default, голубая пунктирная — Portal, зелёная — Proximity, красная — GladiatorArena."/>
            </TextBlock>
        </ScrollViewer>
        <Button Grid.Row="1" x:Name="BtnClose" Content="Закрыть" Width="100" Height="32"
                HorizontalAlignment="Right" Margin="0,8,0,0"
                Background="#2A2A3C" Foreground="#D0D0D0"
                BorderThickness="1" BorderBrush="#3A3A4C"
                Cursor="Hand" Click="BtnClose_Click"/>
    </Grid>
</Window>
