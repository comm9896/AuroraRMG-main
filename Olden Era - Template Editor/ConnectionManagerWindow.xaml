<Window x:Class="Olden_Era___Template_Editor.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Ed.015}" Height="500" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#1E1A2B" UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ManagerHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8A857"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ManagerCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="RemoveBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2A2540" Padding="10,8" CornerRadius="6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="{DynamicResource S.Ed.015}" Style="{StaticResource ManagerHeader}"/>
                <TextBlock x:Name="ConnectionCountText" Text="—"
                           VerticalAlignment="Center" FontSize="12" Foreground="#888"
                           Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <ListView x:Name="ConnectionsList" Grid.Row="1"
                  Background="#2A2540" BorderThickness="0"
                  Margin="0,0,0,8"
                  SelectionMode="Single"
                  MouseDoubleClick="ConnectionsList_MouseDoubleClick"
                  Focusable="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="#D0D0D0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#3A3560"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3A3570"/>
                            <Setter Property="BorderBrush" Value="#6A65A0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#353050"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{x:Null}">
                    <GridView.Columns>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource ManagerCell}"
                                               FontWeight="SemiBold" Foreground="#888"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="140" Header="Откуда">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FromZoneName}" Style="{StaticResource ManagerCell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="40" Header="">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="→" Style="{StaticResource ManagerCell}"
                                               HorizontalAlignment="Center" Foreground="#666"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="140" Header="Куда">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ToZoneName}" Style="{StaticResource ManagerCell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="200" Header="Имя связи">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" Style="{StaticResource ManagerCell}"
                                               FontStyle="Italic" Foreground="#B0A880"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Style="{StaticResource RemoveBtn}"
                                            Tag="{Binding}" Click="RemoveConnection_Click"
                                            ToolTip="Удалить связь"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Background="#2A2540" Padding="10,8" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="Двойной клик по связи — открыть редактор настроек."
                           VerticalAlignment="Center" FontSize="11" Foreground="#666"/>
                <Button x:Name="CloseBtn" Content="Закрыть" DockPanel.Dock="Right"
                        Background="#4A4570" Foreground="#D0D0D0" BorderThickness="0"
                        Padding="16,6" FontSize="12" Cursor="Hand" Click="Close_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
