<Window x:Class="Olden_Era___Template_Editor.ContentPoolViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.CPV.Title}"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        UseLayoutRounding="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search panel -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="11" Padding="4"
                      TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center"/>
            <Button x:Name="ClearSearchBtn" Grid.Column="1" Content="✕" Width="24" Height="24"
                    Margin="4,0,0,0" Click="ClearSearchBtn_Click" ToolTip="{DynamicResource S.CPV.ClearSearch}"/>
            <ComboBox x:Name="CategoryCombo" Grid.Column="3" FontSize="11" Padding="4"
                       SelectionChanged="CategoryCombo_SelectionChanged"/>
            <Button x:Name="ClearCategoryBtn" Grid.Column="4" Content="✕" Width="24" Height="24"
                    Margin="4,0,0,0" Click="ClearCategoryBtn_Click" ToolTip="{DynamicResource S.CPV.ResetCategory}"/>
        </Grid>

        <!-- Debug button -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="ResultCount" Foreground="{StaticResource BrushTextDim}" FontSize="10" VerticalAlignment="Center"/>
            <Button x:Name="DebugBtn" Content="{DynamicResource S.CPV.Debug}" DockPanel.Dock="Right" Padding="8,4" FontSize="10" Click="DebugBtn_Click"/>
        </DockPanel>

        <!-- Pool selector -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <ListBox x:Name="PoolList" SelectionChanged="PoolList_SelectionChanged"
                     MouseDoubleClick="PoolList_MouseDoubleClick"
                     FontSize="11" Foreground="Black" Height="150" Margin="0,0,0,4"
                     Background="White" BorderBrush="{StaticResource BrushBorder}"/>
            <TextBlock x:Name="SourceText" FontSize="10" Foreground="{StaticResource BrushTextDim}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Content grid -->
        <DataGrid Grid.Row="3" x:Name="PoolDataGrid"
                   AutoGenerateColumns="False"
                   IsReadOnly="True"
                   HeadersVisibility="Column"
                   GridLinesVisibility="Horizontal"
                   Background="Transparent"
                   Foreground="{StaticResource BrushText}"
                   FontSize="11"
                   BorderBrush="{StaticResource BrushBorder}"
                   BorderThickness="1"
                   RowBackground="Transparent"
                   AlternatingRowBackground="#15FFFFFF">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource BrushPanelAlt}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource S.CPV.List}" Binding="{Binding ListName}" Width="250"/>
                <DataGridTextColumn Header="{DynamicResource S.CPV.Sid}" Binding="{Binding Sid}" Width="200"/>
                <DataGridTextColumn Header="{DynamicResource S.CPV.Variant}" Binding="{Binding Variant}" Width="60"/>
                <DataGridTextColumn Header="{DynamicResource S.CPV.Biome}" Binding="{Binding Biome}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource S.CPV.MaxCount}" Binding="{Binding Extra}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selection panel (visible only in selection mode) -->
        <StackPanel x:Name="SelectionPanel" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource S.CPV.Selected}" FontSize="11" Foreground="{StaticResource BrushGold}" Margin="0,0,0,4"/>
            <WrapPanel x:Name="SelectionChips" Margin="0,0,0,6"/>
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnAddSelected" Content="{DynamicResource S.CPV.AddSelected}" Padding="8,4" FontSize="11"
                        Click="BtnAddSelected_Click" DockPanel.Dock="Left"/>
                <Button x:Name="BtnOk" Content="{DynamicResource S.CPV.Done}" Padding="14,4" FontSize="11"
                        Click="BtnOk_Click" DockPanel.Dock="Right" Margin="4,0,0,0"/>
                <Button x:Name="BtnCancel" Content="{DynamicResource S.CPV.Cancel}" Padding="14,4" FontSize="11"
                        Click="BtnCancel_Click" DockPanel.Dock="Right" Margin="4,0,0,0"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
